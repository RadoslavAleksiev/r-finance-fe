  <button onclick="window.scrollTo({top:0,behavior:'smooth'})" id="myBtn" title="Go to top">↑</button>

  <script>
    const ADMIN_PASSWORD_HASH = 'e7a7d69be1ed0e82ca3cdae8af7f3502ea0db28646878b8beb47a0f5bd8cafae';
    let isAuthenticated = false;
    let wins = [];
    let filter = 'unpaid';
    let searchWallet = '';
    let loading = false;

    async function sha256(message) {
      const msgBuffer = new TextEncoder().encode(message);
      const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
      const hashArray = Array.from(new Uint8Array(hashBuffer));
      return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    }

    async function handleLogin() {
      const password = document.getElementById('passwordInput').value;
      const inputHash = await sha256(password);
      
      if (inputHash === ADMIN_PASSWORD_HASH) {
        isAuthenticated = true;
        await loadAllWins();
        renderDashboard();
      } else {
        alert('Invalid password');
      }
    }

    async function loadAllWins() {
      loading = true;
      renderDashboard();
      
      try {
        const allKeys = await window.storage.list('win_', true);
        wins = [];
        
        for (const key of allKeys.keys) {
          try {
            const result = await window.storage.get(key, true);
            if (result) {
              const winData = JSON.parse(result.value);
              wins.push({ id: key, ...winData });
            }
          } catch (error) {
            console.error('Error loading win:', key, error);
          }
        }
        
        wins.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
      } catch (error) {
        console.error('Failed to load wins:', error);
        alert('Failed to load wins');
      } finally {
        loading = false;
        renderDashboard();
      }
    }

    async function markAsPaid(winId) {
      try {
        const result = await window.storage.get(winId, true);
        if (result) {
          const winData = JSON.parse(result.value);
          winData.paid = true;
          winData.paidAt = new Date().toISOString();
          await window.storage.set(winId, JSON.stringify(winData), true);
          await loadAllWins();
          alert('Win marked as paid!');
        }
      } catch (error) {
        console.error('Failed to mark as paid:', error);
        alert('Failed to update');
      }
    }

    async function markAsUnpaid(winId) {
      try {
        const result = await window.storage.get(winId, true);
        if (result) {
          const winData = JSON.parse(result.value);
          winData.paid = false;
          delete winData.paidAt;
          await window.storage.set(winId, JSON.stringify(winData), true);
          await loadAllWins();
          alert('Win marked as unpaid!');
        }
      } catch (error) {
        console.error('Failed to mark as unpaid:', error);
        alert('Failed to update');
      }
    }

    async function deleteWin(winId) {
      if (!confirm('Are you sure you want to delete this win record?')) return;
      
      try {
        await window.storage.delete(winId, true);
        await loadAllWins();
        alert('Win deleted!');
      } catch (error) {
        console.error('Failed to delete:', error);
        alert('Failed to delete');
      }
    }

    function exportToCSV() {
      const filteredWins = getFilteredWins();
      const headers = ['Timestamp', 'Wallet Address', 'Amount (points)', 'Symbols', 'Paid', 'Paid At'];
      const rows = filteredWins.map(win => [
        new Date(win.timestamp).toLocaleString(),
        win.wallet,
        win.amount,
        win.symbols.join(' '),
        win.paid ? 'Yes' : 'No',
        win.paidAt ? new Date(win.paidAt).toLocaleString() : 'N/A'
      ]);
      
      const csvContent = [
        headers.join(','),
        ...rows.map(row => row.map(cell => `"${cell}"`).join(','))
      ].join('\\n');
      
      const blob = new Blob([csvContent], { type: 'text/csv' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `raccoon-wins-${new Date().toISOString().split('T')[0]}.csv`;
      a.click();
    }

    function getFilteredWins() {
      let filtered = wins;
      
      if (filter === 'paid') {
        filtered = filtered.filter(win => win.paid);
      } else if (filter === 'unpaid') {
        filtered = filtered.filter(win => !win.paid);
      }
      
      if (searchWallet.trim()) {
        filtered = filtered.filter(win => 
          win.wallet.toLowerCase().includes(searchWallet.toLowerCase())
        );
      }
      
      return filtered;
    }

    function getStats() {
      const totalWins = wins.length;
      const paidWins = wins.filter(w => w.paid).length;
      const unpaidWins = wins.filter(w => !w.paid).length;
      const totalAmount = wins.reduce((sum, w) => sum + w.amount, 0);
      const paidAmount = wins.filter(w => w.paid).reduce((sum, w) => sum + w.amount, 0);
      const unpaidAmount = wins.filter(w => !w.paid).reduce((sum, w) => sum + w.amount, 0);
      const uniqueWallets = new Set(wins.map(w => w.wallet)).size;
      
      return { totalWins, paidWins, unpaidWins, totalAmount, paidAmount, unpaidAmount, uniqueWallets };
    }

    function renderLogin() {
      document.getElementById('app').innerHTML = `
        <div class="login-card">
          <div class="raccoon-icon">🦝</div>
          <h2>Admin Dashboard</h2>
          <p>Enter password to access</p>
          
          <input type="password" id="passwordInput" placeholder="Enter admin password"
            onkeypress="if(event.key==='Enter') handleLogin()">
          <button onclick="handleLogin()">Login</button>
        </div>
      `;
    }

    function renderDashboard() {
      if (!isAuthenticated) {
        renderLogin();
        return;
      }

      const stats = getStats();
      const filteredWins = getFilteredWins();

      document.getElementById('app').innerHTML = `
        <div class="dashboard-header">
          <div>
            <h2>🦝 Admin Dashboard</h2>
            <p>Manage player wins and payouts</p>
          </div>
          <button class="logout-btn" onclick="isAuthenticated=false; renderDashboard()">Logout</button>
        </div>

        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-header">
              <div class="stat-icon">🏆</div>
              <div class="stat-title">Total Wins</div>
            </div>
            <div class="stat-value orange">${stats.totalWins}</div>
            <div class="stat-subtitle">${stats.totalAmount} points</div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <div class="stat-icon">✓</div>
              <div class="stat-title">Paid Wins</div>
            </div>
            <div class="stat-value green">${stats.paidWins}</div>
            <div class="stat-subtitle">${stats.paidAmount} points</div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <div class="stat-icon">⏳</div>
              <div class="stat-title">Unpaid Wins</div>
            </div>
            <div class="stat-value yellow">${stats.unpaidWins}</div>
            <div class="stat-subtitle">${stats.unpaidAmount} points</div>
          </div>

          <div class="stat-card">
            <div class="stat-header">
              <div class="stat-icon">👥</div>
              <div class="stat-title">Unique Players</div>
            </div>
            <div class="stat-value blue">${stats.uniqueWallets}</div>
            <div class="stat-subtitle">wallet addresses</div>
          </div>
        </div>

        <div class="controls-panel">
          <div class="controls-flex">
            <input type="text" class="search-input" value="${searchWallet}" placeholder="Search by wallet address..."
              oninput="searchWallet=this.value; renderDashboard()">

            <button class="filter-btn ${filter === 'all' ? 'active' : ''}" onclick="filter='all'; renderDashboard()">All</button>
            <button class="filter-btn ${filter === 'unpaid' ? 'active' : ''}" onclick="filter='unpaid'; renderDashboard()">Unpaid</button>
